---
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE, AFFILIATE_NOTICE } from '../config/site.mjs';

const { title, description, jsonLd = [], noindex = false, ogType = 'website', ogImage } = Astro.props;
const fullTitle = title === SITE_NAME ? `${SITE_NAME} — ${SITE_TAGLINE}` : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage ?? new URL('/og-image.png', Astro.site).toString();
const nav = [
  { href: '/okazje', label: 'Okazje dla każdego', short: 'Okazje' },
  { href: '/kody-rabatowe', label: 'Kody rabatowe', short: 'Kody' },
  { href: '/o-serwisie', label: 'O serwisie' }
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#b8294d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://image.weben1.com" crossorigin />
    <link rel="dns-prefetch" href="https://webep1.com" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-30 border-b border-line bg-cream/95 backdrop-blur">
      <div class="container-wide flex min-h-14 items-center justify-between gap-3">
        <a href="/" class="flex shrink-0 items-center gap-1.5 whitespace-nowrap text-base font-extrabold text-berry sm:text-lg">
          <span aria-hidden="true" class="text-xl sm:text-2xl">🎁</span>{SITE_NAME}
        </a>
        <nav aria-label="Główna nawigacja" class="flex gap-1 text-sm font-semibold sm:gap-2 sm:text-base">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}
               class:list={['rounded-lg px-2.5 py-2 hover:bg-blush sm:px-3', path === n.href && 'bg-blush text-berry', n.href === '/o-serwisie' && 'hidden sm:block']}>
              {n.short ? <><span class="sm:hidden">{n.short}</span><span class="hidden sm:inline">{n.label}</span></> : n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1"><slot /></main>

    <footer class="mt-16 border-t border-line bg-white">
      <div class="container-wide space-y-4 py-8 text-sm text-muted">
        <p class="text-xs">{AFFILIATE_NOTICE} <a href="/o-serwisie" class="underline hover:text-berry">Zasady serwisu</a></p>
        <nav aria-label="Stopka" class="flex flex-wrap gap-x-5 gap-y-2 font-semibold text-ink">
          <a href="/okazje" class="hover:text-berry">Okazje</a>
          <a href="/kody-rabatowe" class="hover:text-berry">Kody rabatowe</a>
          <a href="/o-serwisie" class="hover:text-berry">O serwisie</a>
          <a href="/polityka-prywatnosci" class="hover:text-berry">Polityka prywatności</a>
        </nav>
        <p>© {new Date().getFullYear()} {SITE_NAME}. Nazwy sklepów i produktów należą do ich właścicieli.</p>
      </div>
    </footer>

    <div id="scrollrail" aria-hidden="true" class="fixed bottom-3 right-0 top-16 z-40 hidden w-5 touch-none select-none">
      <div class="absolute bottom-0 right-1 top-0 w-1.5 rounded-full bg-berry/15"></div>
      <div id="scrollthumb" class="absolute right-0.5 w-2.5 cursor-grab rounded-full bg-berry shadow" style="height:48px;top:0"></div>
    </div>

    <dialog id="lightbox" class="m-0 h-full max-h-none w-full max-w-none bg-ink/90 p-0 backdrop:bg-ink/90" aria-label="Galeria zdjęć produktu">
      <div class="flex h-full flex-col items-center justify-center gap-3 p-3">
        <p id="lb-title" class="max-w-3xl text-center text-base font-bold text-white"></p>
        <div class="relative flex min-h-0 w-full max-w-5xl flex-1 items-center justify-center">
          <img id="lb-img" src="" alt="" class="max-h-full max-w-full rounded-lg bg-white object-contain" />
          <button type="button" id="lb-prev" aria-label="Poprzednie zdjęcie" class="absolute left-0 grid h-12 w-12 place-items-center rounded-full bg-white/90 text-3xl font-bold text-berry">‹</button>
          <button type="button" id="lb-next" aria-label="Następne zdjęcie" class="absolute right-0 grid h-12 w-12 place-items-center rounded-full bg-white/90 text-3xl font-bold text-berry">›</button>
        </div>
        <p id="lb-count" class="text-sm font-semibold text-white"></p>
        <button type="button" id="lb-close" class="btn btn-primary">Zamknij</button>
      </div>
    </dialog>

    <script is:inline>
      // Galeria zdjęć w kartach produktów + powiększenie (bez bibliotek).
      (function () {
        var lb = document.getElementById('lightbox');
        var img = document.getElementById('lb-img');
        var list = [], idx = 0, title = '';
        function show(i) {
          idx = (i + list.length) % list.length;
          img.src = list[idx];
          img.alt = title;
          document.getElementById('lb-count').textContent = list.length > 1 ? (idx + 1) + ' / ' + list.length : '';
          document.getElementById('lb-prev').style.display = document.getElementById('lb-next').style.display = list.length > 1 ? '' : 'none';
        }
        function counter(g) {
          var t = g.querySelector('[data-track]'), c = g.querySelector('[data-counter]');
          if (!c) return;
          c.textContent = (Math.round(t.scrollLeft / t.clientWidth) + 1) + '/' + t.children.length;
        }
        document.addEventListener('click', function (e) {
          var arrow = e.target.closest('[data-g]');
          if (arrow) {
            var t = arrow.closest('[data-gallery]').querySelector('[data-track]');
            t.scrollBy({ left: Number(arrow.getAttribute('data-g')) * t.clientWidth, behavior: 'smooth' });
            return;
          }
          var z = e.target.closest('[data-zoom]');
          if (z) {
            var g = z.closest('[data-gallery]');
            list = Array.prototype.map.call(g.querySelectorAll('[data-zoom]'), function (b) { return b.getAttribute('data-zoom'); });
            title = g.closest('[data-name]').getAttribute('data-name') || '';
            document.getElementById('lb-title').textContent = title;
            show(list.indexOf(z.getAttribute('data-zoom')));
            if (lb.showModal) lb.showModal(); else lb.setAttribute('open', '');
          }
        });
        document.addEventListener('scroll', function (e) {
          var t = e.target;
          if (t && t.matches && t.matches('[data-track]')) counter(t.closest('[data-gallery]'));
        }, true);
        document.getElementById('lb-prev').addEventListener('click', function () { show(idx - 1); });
        document.getElementById('lb-next').addEventListener('click', function () { show(idx + 1); });
        document.getElementById('lb-close').addEventListener('click', function () { lb.close(); });
        lb.addEventListener('click', function (e) { if (e.target === lb) lb.close(); });
        lb.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') show(idx - 1);
          if (e.key === 'ArrowRight') show(idx + 1);
        });
      })();

      // Suwak strony po prawej: pokazuje (i pozwala przeciągnąć) pozycję na stronie.
      (function () {
        var rail = document.getElementById('scrollrail'), thumb = document.getElementById('scrollthumb');
        var de = document.documentElement, drag = null;
        function layout() {
          var max = de.scrollHeight - de.clientHeight;
          if (max < 80) { rail.classList.add('hidden'); return; }
          rail.classList.remove('hidden');
          var track = rail.clientHeight;
          var h = Math.max(48, Math.round(track * de.clientHeight / de.scrollHeight));
          thumb.style.height = h + 'px';
          thumb.style.top = Math.round((track - h) * (window.scrollY / max)) + 'px';
        }
        function scrollToY(clientY, offset) {
          var r = rail.getBoundingClientRect(), h = thumb.offsetHeight;
          var ratio = Math.min(1, Math.max(0, (clientY - r.top - offset) / (r.height - h)));
          window.scrollTo({ top: ratio * (de.scrollHeight - de.clientHeight), behavior: 'instant' });
        }
        rail.addEventListener('pointerdown', function (e) {
          rail.setPointerCapture(e.pointerId);
          var tr = thumb.getBoundingClientRect();
          drag = e.target === thumb ? e.clientY - tr.top : thumb.offsetHeight / 2;
          thumb.style.cursor = 'grabbing';
          if (e.target !== thumb) scrollToY(e.clientY, drag);
        });
        rail.addEventListener('pointermove', function (e) { if (drag !== null) scrollToY(e.clientY, drag); });
        rail.addEventListener('pointerup', function () { drag = null; thumb.style.cursor = 'grab'; });
        window.addEventListener('scroll', layout, { passive: true });
        window.addEventListener('resize', layout);
        window.addEventListener('load', layout);
        if (window.ResizeObserver) new ResizeObserver(layout).observe(document.body);
        layout();
      })();
    </script>

    <script is:inline>
      // Kopiowanie kodu rabatowego (delegacja zdarzeń, bez bibliotek).
      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-copy]');
        if (!btn) return;
        const code = btn.getAttribute('data-copy');
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = code; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); } catch {}
          ta.remove();
        }
        const label = btn.querySelector('[data-label]') || btn;
        const old = label.textContent;
        label.textContent = 'Skopiowano ✓';
        setTimeout(() => (label.textContent = old), 2000);
      });
    </script>
  </body>
</html>
