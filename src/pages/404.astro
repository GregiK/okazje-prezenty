---
import Base from '../layouts/Base.astro';
---
<Base title="Nie znaleziono strony" description="Taka strona nie istnieje. Wróć do okazji i kodów rabatowych." noindex>
  <div class="container-x py-16 text-center">
    <p class="text-6xl" aria-hidden="true">🎁</p>
    <h1 class="mt-4 text-3xl font-extrabold">Nie znaleziono strony</h1>
    <p class="mt-2 text-muted">Sprawdź adres lub wróć do okazji.</p>
    <a href="/okazje" class="btn btn-primary mt-6">Zobacz okazje</a>
  </div>
</Base>
