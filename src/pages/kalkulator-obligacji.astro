---
import Base from '../layouts/Base.astro';
import { breadcrumbs } from '../lib/seo.mjs';

// Publiczne parametry kalkulatora LeadStar (z kodu do osadzenia w panelu) — to nie są klucze tajne.
const BOND_ID = '41';
const BOND_HASH = '5c99858f4653de6b';
const BOND_PAGE = `https://obligacje.leadstar.com.pl/obligacje?pbc_id=${BOND_ID}&pbc_hash=${BOND_HASH}`;

const description = 'Kalkulator obligacji: sprawdź, ile możesz zarobić na obligacjach skarbowych i korporacyjnych. Materiał reklamowy partnera LeadStar.';
const jsonLd = [breadcrumbs(Astro.site, [{ name: 'Strona główna', path: '/' }, { name: 'Kalkulator obligacji', path: '/kalkulator-obligacji' }])];
---
<Base title="Kalkulator obligacji" description={description} jsonLd={jsonLd}>
  <div class="container-wide space-y-5 py-8 leading-relaxed">
    <h1 class="max-w-3xl text-3xl font-extrabold tracking-tight sm:text-4xl">Kalkulator obligacji</h1>
    <p class="max-w-3xl">Sprawdź, ile mogą Ci przynieść obligacje: wpisz kwotę i okres, a kalkulator pokaże przykładowe oferty i szacowany zysk.</p>

    <p class="max-w-3xl rounded-xl border border-line bg-white p-3 text-sm text-muted">
      <strong>Materiał reklamowy.</strong> Kalkulator udostępnia partner LeadStar, a nasz serwis może otrzymać prowizję za zawarcie umowy po kliknięciu w ofertę. Obligacje wiążą się z ryzykiem, w tym ryzykiem utraty części lub całości zainwestowanych środków. Wyniki mają charakter orientacyjny i <strong>nie stanowią porady inwestycyjnej ani rekomendacji</strong>.
    </p>

    <section aria-labelledby="calc-h" class="-mx-4 border-y border-line bg-white px-3 py-4 shadow-sm sm:mx-0 sm:max-w-4xl sm:rounded-2xl sm:border sm:p-5">
      <h2 id="calc-h" class="sr-only">Kalkulator</h2>
      <div id="bond-box">
        <p class="text-sm text-muted">Kalkulator jest ładowany z serwera partnera (<code>obligacje.leadstar.com.pl</code>) dopiero po kliknięciu — wtedy ten serwis może zapisać własne pliki cookie i zobaczy Twój adres IP. Szczegóły w <a href="/polityka-prywatnosci" class="underline hover:text-berry">polityce prywatności</a>.</p>
        <button id="bond-load" type="button" class="btn btn-primary mt-3 w-full sm:w-auto sm:min-w-52">Pokaż kalkulator</button>
        <p class="mt-3 text-sm text-muted">Nie działa? <a href={BOND_PAGE} target="_blank" rel="sponsored nofollow noopener" class="font-bold text-berry underline">Otwórz kalkulator w nowej karcie</a>.</p>
      </div>
      <div id="bond-widget" class="mt-3 w-full min-w-0 overflow-x-auto text-base [&_*]:max-w-full" aria-live="polite"></div>
      <noscript><p class="text-sm text-muted">Kalkulator wymaga włączonej obsługi JavaScript. <a href={BOND_PAGE} target="_blank" rel="sponsored nofollow noopener" class="font-bold text-berry underline">Otwórz go w nowej karcie</a>.</p></noscript>
    </section>
  </div>

  <script is:inline define:vars={{ BOND_ID, BOND_HASH }}>
    // Oficjalny kod osadzania LeadStar, uruchamiany dopiero po kliknięciu (bez zewnętrznych skryptów przy samym wejściu na stronę).
    document.getElementById('bond-load').addEventListener('click', function () {
      var btn = this, host = document.getElementById('bond-widget');
      btn.disabled = true; btn.textContent = 'Ładowanie…';
      var anchor = document.createElement('script'); // odpowiednik elementu <script> z kodu LeadStar (punkt wstawienia kalkulatora)
      anchor.type = 'text/plain';
      host.appendChild(anchor);
      var url = new URL('https://obligacje.leadstar.com.pl/getBondCode');
      url.searchParams.append('pbc_id', BOND_ID);
      url.searchParams.append('pbc_hash', BOND_HASH);
      var s = document.createElement('script');
      s.type = 'text/javascript';
      s.async = false;
      s.src = url.toString();
      s.onload = function () {
        if (typeof lsBond !== 'undefined') {
          lsBond.start({ pbc_epi1: '', pbc_epi2: '' }, anchor);
          document.getElementById('bond-box').hidden = true;
        } else { fail(); }
      };
      s.onerror = fail;
      function fail() { btn.disabled = false; btn.textContent = 'Spróbuj ponownie'; host.textContent = 'Nie udało się załadować kalkulatora. Użyj linku „Otwórz kalkulator w nowej karcie”.'; }
      anchor.parentNode.insertBefore(s, anchor);
    });
  </script>
</Base>
