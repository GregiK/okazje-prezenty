---
import Base from '../layouts/Base.astro';
import VoucherCard from '../components/VoucherCard.astro';
import { vouchers, updatedDate } from '../lib/data.mjs';

const description = `Aktualne kody rabatowe i promocje sklepów internetowych (${vouchers.length}). Skopiuj kod jednym kliknięciem i przejdź do sklepu. Aktualizacja: ${updatedDate}.`;
---
<Base title="Kody rabatowe i promocje" description={description}>
  <div class="container-wide space-y-5 py-6">
    <header>
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Kody rabatowe</h1>
      <p class="mt-1 text-muted">Sprawdzamy daty ważności przy każdej aktualizacji (ostatnia: {updatedDate}). Kod może wygasnąć wcześniej — wpisz go w koszyku sklepu.</p>
    </header>
    {vouchers.length ? (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {vouchers.map((v) => <VoucherCard voucher={v} pageType="kody" />)}
      </div>
    ) : (
      <p class="rounded-2xl border border-line bg-white p-6 text-center text-muted">Aktualnie brak kodów rabatowych. Zajrzyj do <a href="/okazje" class="font-bold text-berry underline">okazji</a> — codziennie aktualizujemy ceny.</p>
    )}
  </div>
</Base>
