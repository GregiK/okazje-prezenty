---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import VoucherCard from '../components/VoucherCard.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import ProductRow from '../components/ProductRow.astro';
import SectionHead from '../components/SectionHead.astro';
import { products, productsByDiscount, dealProducts, heroProducts, vouchers, activeCategories, activeCollections, activeShops, updatedDate } from '../lib/data.mjs';
import { productItemList } from '../lib/seo.mjs';
import { SITE_NAME } from '../config/site.mjs';

const top = dealProducts.slice(0, 12);
const featured = [...products].sort((a, b) => a.price - b.price).slice(0, 12);
const topVouchers = vouchers.slice(0, 6);
const sections = activeCategories.map((c) => ({
  ...c,
  items: products.filter((p) => p.category === c.slug).sort((a, b) => b.discount - a.discount).slice(0, 4)
}));
const description = `Sprawdzone okazje, kody rabatowe i pomysły na prezent z polskich sklepów. ${products.length} produktów w obniżonych cenach, aktualizacja codziennie.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: Astro.site.toString(),
    inLanguage: 'pl-PL'
  },
  productItemList(top, 'Największe obniżki')
];
---
<Base title={SITE_NAME} description={description} jsonLd={jsonLd}>
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-blush to-cream">
    {heroProducts.length === 3 && (
      <>
        <div class="absolute inset-x-0 top-0 -z-20 grid h-56 grid-cols-3 sm:inset-0 sm:h-auto" aria-hidden="true">
          {heroProducts.map((p) => (
            <img src={p.image} alt="" width="640" height="640" loading="eager" fetchpriority="low" decoding="async" draggable="false" class="h-full w-full bg-white object-cover" />
          ))}
        </div>
        <div class="absolute inset-x-0 top-0 -z-10 h-56 bg-gradient-to-b from-transparent via-cream/25 to-cream sm:inset-0 sm:h-auto sm:from-cream/30 sm:via-cream/55" aria-hidden="true"></div>
      </>
    )}
    <div class="container-wide pb-10 pt-40 text-center sm:py-16 lg:py-24">
      <div class="mx-auto max-w-3xl rounded-3xl bg-cream/85 px-4 py-6 shadow-sm backdrop-blur-sm sm:px-8 sm:py-8">
        <p class="mb-3 inline-block rounded-full bg-white px-4 py-1 text-sm font-bold text-berry shadow-sm">🎁 Aktualizacja: {updatedDate}</p>
        <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">Okazje i pomysły na prezent</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">Największe obniżki i aktualne kody rabatowe z wybranych sklepów — biżuteria, perfumy, gadżety i prezenty dla bliskich.</p>
        <div class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center">
          <a href="/okazje" class="btn btn-primary sm:min-w-52">Zobacz okazje</a>
          <a href="/kody-rabatowe" class="btn btn-light sm:min-w-52">Kody rabatowe</a>
        </div>
      </div>
    </div>
  </section>

  <div class="container-wide space-y-12 pt-6">
    <AffiliateNotice />

    {activeCategories.length > 0 && (
      <nav aria-label="Kategorie" class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1">
        {activeCategories.map((c) => (
          <a href={`/okazje?kategoria=${c.slug}`} class="flex shrink-0 items-center gap-2 rounded-full border border-line bg-white px-4 py-3 text-sm font-bold shadow-sm hover:border-berry">
            <span aria-hidden="true">{c.icon}</span>{c.name}
          </a>
        ))}
      </nav>
    )}

    {top.length > 0 ? (
      <section>
        <SectionHead title="🔥 Największe obniżki" href="/okazje?obnizka=1" />
        <p class="-mt-2 mb-4 text-sm text-muted">Tylko obniżki z ostatnich 30 dni. „Przed obniżką” to najniższa cena z 30 dni przed obniżką.</p>
        <ProductRow>
          {top.map((p, i) => <div class="flex w-full md:w-[calc((100%-2rem)/3)] md:shrink-0 md:snap-start lg:w-[calc((100%-3rem)/4)]"><ProductCard product={p} pageType="glowna" eager={i < 4} /></div>)}
        </ProductRow>
      </section>
    ) : (
      <section>
        <SectionHead title="🎁 Polecane produkty" href="/okazje" />
        <ProductRow>
          {featured.map((p, i) => <div class="flex w-full md:w-[calc((100%-2rem)/3)] md:shrink-0 md:snap-start lg:w-[calc((100%-3rem)/4)]"><ProductCard product={p} pageType="glowna" eager={i < 4} /></div>)}
        </ProductRow>
      </section>
    )}

    <section>
      <SectionHead title="🏷️ Aktualne kody rabatowe" href="/kody-rabatowe" />
      {topVouchers.length ? (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {topVouchers.map((v) => <VoucherCard voucher={v} pageType="glowna" />)}
        </div>
      ) : (
        <p class="rounded-2xl border border-line bg-white p-6 text-muted">Aktualnie brak kodów rabatowych — zajrzyj później, dodajemy je na bieżąco.</p>
      )}
    </section>

    {activeCollections.length > 0 && (
      <section>
        <SectionHead title="🎀 Pomysły na prezent według budżetu" />
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {activeCollections.map((c) => (
            <a href={`/prezenty/${c.slug}`} class="flex min-h-24 flex-col items-center justify-center gap-1 rounded-2xl border border-line bg-white p-4 text-center font-extrabold shadow-sm hover:border-berry">
              <span class="text-3xl" aria-hidden="true">{c.icon}</span>
              <span>{c.name}</span>
              <span class="text-xs font-semibold text-muted">{c.items.length} pomysłów</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {sections.map((c) => (
      <section>
        <SectionHead title={`${c.icon} ${c.name}`} href={`/okazje?kategoria=${c.slug}`} />
        <ProductRow>
          {c.items.map((p) => <div class="flex w-full md:w-[calc((100%-2rem)/3)] md:shrink-0 md:snap-start lg:w-[calc((100%-3rem)/4)]"><ProductCard product={p} pageType="glowna" /></div>)}
        </ProductRow>
      </section>
    ))}

    <section>
      <SectionHead title="🛍️ Sklepy" />
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {activeShops.map((s) => (
          <a href={`/sklep/${s.slug}`} class="flex min-h-20 flex-col items-center justify-center gap-2 rounded-2xl border border-line bg-white p-4 text-center font-bold shadow-sm hover:border-berry">
            {s.logo && <img src={s.logo} alt="" loading="lazy" width="96" height="40" class="h-10 w-auto max-w-full object-contain" />}
            <span class="text-sm">{s.name}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
