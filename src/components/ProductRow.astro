---
// Telefon: jedna kolumna (karty jedna pod drugą). Komputer (md+): jeden rząd na całą szerokość,
// przewijany poziomo (scroll-snap) z przyciskami ‹ ›.
---
<div class="product-row relative">
  <div data-row class="flex flex-col gap-4 md:snap-x md:snap-mandatory md:flex-row md:overflow-x-auto md:scroll-smooth md:py-1 md:pb-3 md:[scrollbar-width:thin]">
    <slot />
  </div>
  <button type="button" data-dir="-1" aria-label="Poprzednie produkty"
    class="absolute left-2 top-1/3 hidden h-12 w-12 place-items-center rounded-full border border-line bg-white/95 text-3xl font-bold text-berry shadow-md hover:bg-blush md:grid">‹</button>
  <button type="button" data-dir="1" aria-label="Następne produkty"
    class="absolute right-2 top-1/3 hidden h-12 w-12 place-items-center rounded-full border border-line bg-white/95 text-3xl font-bold text-berry shadow-md hover:bg-blush md:grid">›</button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.product-row').forEach((row) => {
    const scroller = row.querySelector<HTMLElement>('[data-row]')!;
    row.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () =>
        scroller.scrollBy({ left: Number(b.dataset.dir) * scroller.clientWidth * 0.9, behavior: 'smooth' })
      )
    );
  });
</script>
