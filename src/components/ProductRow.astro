---
// Jeden rząd produktów przewijany w poziomie (scroll-snap) — przyciski ‹ › na większych ekranach.
---
<div class="product-row relative">
  <div data-row class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto scroll-smooth px-4 pb-3 sm:gap-4 [scrollbar-width:thin]">
    <slot />
  </div>
  <button type="button" data-dir="-1" aria-label="Poprzednie produkty"
    class="absolute left-0 top-1/3 hidden h-11 w-11 -translate-x-1/2 place-items-center rounded-full border border-line bg-white text-2xl font-bold text-berry shadow-md hover:bg-blush md:grid">‹</button>
  <button type="button" data-dir="1" aria-label="Następne produkty"
    class="absolute right-0 top-1/3 hidden h-11 w-11 translate-x-1/2 place-items-center rounded-full border border-line bg-white text-2xl font-bold text-berry shadow-md hover:bg-blush md:grid">›</button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.product-row').forEach((row) => {
    const scroller = row.querySelector<HTMLElement>('[data-row]')!;
    row.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () =>
        scroller.scrollBy({ left: Number(b.dataset.dir) * scroller.clientWidth * 0.85, behavior: 'smooth' })
      )
    );
  });
</script>
